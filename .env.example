# DroneWatch reads process environment variables directly. This file is a
# reference only; it is not loaded automatically. Keep every real credential in
# an untracked local environment or secret store.

# Required for webhook writes and authenticated legacy access. Supply a unique
# value of at least 32 visible ASCII characters locally. Never commit it.
DRONEWATCH_WEBHOOK_TOKEN=

# Backend/database controls.
DRONEWATCH_DB_PATH=dronewatch.db
DRONEWATCH_WEBHOOK_MAX_BYTES=65536
DRONEWATCH_MAX_FUTURE_SECONDS=60
DRONEWATCH_OBSERVATION_RETENTION_DAYS=30
DRONEWATCH_OBSERVATION_MAX_COUNT=10000
DRONEWATCH_CONFLICT_RETENTION_DAYS=7
DRONEWATCH_CONFLICT_MAX_COUNT=1000
DRONEWATCH_SIMULATION=0

# Optional macOS bounded-replay launcher inputs. Blank values cause the launcher
# to prompt or use its documented repository-local default.
DRONEWATCH_SCENARIO_ID=
DRONEWATCH_RUN_ID=
DRONEWATCH_FIXTURE_ID=
DRONEWATCH_FIXTURE_MANIFEST=
DRONEWATCH_DEMO_SOURCE=
DRONEWATCH_DRIVE_FOLDER=
DRONEWATCH_COPY_COUNT=
DRONEWATCH_COPY_INTERVAL=25
DRONEWATCH_RUN_RECORD_DIR=
DRONEWATCH_PYTHON=

# Viso account/API OAuth and connector credentials intentionally have no
# DroneWatch environment variables here. Keep them blank/external until actual
# account evidence and explicit authorization establish a requirement.
