{
  "$comment": "This schema defines the portable structure. Cross-field and pack-level semantic rules are normatively enforced by replay_artifacts.py and scripts/verify_replay_artifacts.py.",
  "$defs": {
    "ReplayCopyV1": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed At"
        },
        "completed_copy_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed Copy Sha256"
        },
        "destination_basename": {
          "title": "Destination Basename",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReplayFailureCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence_number": {
          "maximum": 20,
          "minimum": 1,
          "title": "Sequence Number",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ReplayState"
        }
      },
      "required": [
        "sequence_number",
        "source_sha256",
        "destination_basename",
        "started_at",
        "completed_at",
        "completed_copy_sha256",
        "state",
        "failure_code"
      ],
      "title": "ReplayCopyV1",
      "type": "object"
    },
    "ReplayFailureCode": {
      "enum": [
        "INVALID_RUN_CONFIGURATION",
        "INVALID_DESTINATION_BASENAME",
        "SOURCE_NOT_FOUND",
        "SOURCE_NOT_REGULAR",
        "SOURCE_EMPTY",
        "WATCH_DIR_NOT_FOUND",
        "WATCH_DIR_NOT_DIRECTORY",
        "SOURCE_INSIDE_WATCH_DIR",
        "RECORD_DIR_INSIDE_WATCH_DIR",
        "RECORD_ALREADY_EXISTS",
        "RECORD_WRITE_FAILED",
        "MANIFEST_NOT_FOUND",
        "MANIFEST_INVALID",
        "MANIFEST_NOT_VERIFIED",
        "FIXTURE_NOT_FOUND",
        "FIXTURE_BASENAME_MISMATCH",
        "SOURCE_SIZE_MISMATCH",
        "SOURCE_HASH_MISMATCH",
        "SOURCE_CHANGED_DURING_COPY",
        "COMPLETED_COPY_HASH_MISMATCH",
        "DESTINATION_EXISTS",
        "COPY_IO_FAILED",
        "INTERRUPTED"
      ],
      "title": "ReplayFailureCode",
      "type": "string"
    },
    "ReplayState": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "INTERRUPTED"
      ],
      "title": "ReplayState",
      "type": "string"
    }
  },
  "$id": "https://dronewatch.invalid/schemas/dronewatch.replay-run.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "completed_count": {
      "maximum": 20,
      "minimum": 0,
      "title": "Completed Count",
      "type": "integer"
    },
    "copies": {
      "items": {
        "$ref": "#/$defs/ReplayCopyV1"
      },
      "title": "Copies",
      "type": "array"
    },
    "delivery_mode": {
      "const": "NEAR_REAL_TIME_FILE_REPLAY",
      "title": "Delivery Mode",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayFailureCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture_id": {
      "maxLength": 64,
      "minLength": 1,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Fixture Id",
      "type": "string"
    },
    "interval_seconds": {
      "maximum": 30.0,
      "minimum": 20.0,
      "title": "Interval Seconds",
      "type": "number"
    },
    "manifest_id": {
      "maxLength": 64,
      "minLength": 1,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "proof_boundary": {
      "const": "LOCAL_ATOMIC_COPY_ONLY_NOT_DRIVE_SYNC_VISO_PROCESSING_OR_WEBHOOK_DELIVERY",
      "title": "Proof Boundary",
      "type": "string"
    },
    "provenance": {
      "const": "REPLAYED_REAL",
      "title": "Provenance",
      "type": "string"
    },
    "requested_count": {
      "maximum": 20,
      "minimum": 1,
      "title": "Requested Count",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 64,
      "minLength": 1,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 64,
      "minLength": 1,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dronewatch.replay-run.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ReplayState"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "run_id",
    "fixture_id",
    "manifest_id",
    "delivery_mode",
    "provenance",
    "source_sha256",
    "requested_count",
    "interval_seconds",
    "started_at",
    "completed_at",
    "state",
    "failure_code",
    "completed_count",
    "copies",
    "proof_boundary"
  ],
  "title": "DroneWatch replay run record v1",
  "type": "object"
}
